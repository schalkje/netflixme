# Copy this file to .env.local and fill in your keys.
# You can also enter all of these in the in-app Setup screen (stored in ./.data).

# --- Simkl (tracking backbone: seen / my-list / dropped / ratings) ---
# Register an app at https://simkl.com/settings/developer to get these.
# Set the redirect URI there to: http://localhost:3000/api/auth/simkl/callback
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=

# --- TMDB (the "what's on Netflix in my region" catalog + posters) ---
# Free key: https://www.themoviedb.org/settings/api  (v3 API key)
TMDB_API_KEY=

# --- OMDb (real IMDb scores) ---
# Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# --- Your Netflix region (ISO 3166-1 alpha-2), e.g. NL, US, GB ---
NEXT_PUBLIC_WATCH_REGION=NL

# --- Base URL of this app (used to build the OAuth redirect URI) ---
APP_BASE_URL=http://localhost:3000

# --- Secret used to encrypt stored OAuth tokens at rest (any long random string) ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NETFLIXME_SECRET=
