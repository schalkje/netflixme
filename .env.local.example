# Copy this file to .env.local and fill in your keys.
# You can also enter TMDB/OMDb/region in the in-app Setup screen (stored in ./.data).

# --- TMDB (the "what's on Netflix in my region" catalog + posters) ---
# Free key: https://www.themoviedb.org/settings/api  (v3 API key)
TMDB_API_KEY=

# --- OMDb (real IMDb scores) ---
# Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# --- Your Netflix region (ISO 3166-1 alpha-2), e.g. NL, US, GB ---
NEXT_PUBLIC_WATCH_REGION=NL

# --- Base URL of this app (shown in Setup so the browser extension can target it) ---
APP_BASE_URL=http://localhost:3000

# Note: the ingest token used by the companion browser extension is generated
# automatically and shown in the Setup screen — no env var needed.
